# ════════════════════════════════════════════════════════
# rigor-api — Backend Environment Variables (SECRET)
# Copy to .env.local — NEVER commit to git
# ════════════════════════════════════════════════════════

# ── Firebase Admin SDK (project mdo3d-career) ──
# Firebase console > mdo3d-career > Project settings > Service accounts >
# "Generate new private key" (firebase-adminsdk-…@mdo3d-career.iam.gserviceaccount.com).
# Paste client_email and private_key from that JSON; never commit the JSON.
FIREBASE_PROJECT_ID=mdo3d-career
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Stripe Secret Keys ───────────────────────────────────
# TEST (development)
STRIPE_SECRET_KEY_TEST=sk_test_
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_
# LIVE (production)
STRIPE_SECRET_KEY_LIVE=sk_live_
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_

# Active keys (switch between TEST/LIVE)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_test_

# Stripe Price IDs (must match frontend). REQUIRED: checkout returns 503 and the
# webhook grants nothing for prices not listed here. Comma-separated.
STRIPE_PRO_PRICE_IDS=price_test_pro
STRIPE_TEAM_PRICE_IDS=price_test_team

# ── Server-side usage limits (api/lib/quota.js) ──────────
# Free plan: shared monthly AI generations across all 7 tools (default 3) and
# interview answer reviews (default 30). Pro/Team are unlimited.
RIGOR_FREE_MONTHLY_LIMIT=3
RIGOR_FREE_FEEDBACK_LIMIT=30

# ── Firebase App Check (optional; leave false until monitored traffic is clean) ──
APPCHECK_ENFORCE=false

# ── Anthropic (Claude API) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-

# ── App Config ───────────────────────────────────────────
APP_URL=http://localhost:3001
NODE_ENV=development
PORT=3001
