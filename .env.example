# ════════════════════════════════════════════════════════
# rigor-api — Backend Environment Variables (SECRET)
# Copy to .env.local — NEVER commit to git
# ════════════════════════════════════════════════════════

# ── Firebase Admin SDK (from Firebase Console > Service Accounts) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Stripe Secret Keys ───────────────────────────────────
# TEST (development)
STRIPE_SECRET_KEY_TEST=sk_test_
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_
# LIVE (production)
STRIPE_SECRET_KEY_LIVE=sk_live_
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_

# Active keys (switch between TEST/LIVE)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_test_

# Stripe Price IDs (must match frontend)
STRIPE_PRO_PRICE_IDS=price_test_pro
STRIPE_TEAM_PRICE_IDS=price_test_team

# ── Anthropic (Claude API) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-

# ── App Config ───────────────────────────────────────────
APP_URL=http://localhost:3001
NODE_ENV=development
PORT=3001
